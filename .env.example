# ============================================
# Urna Digital Chihuahua - Variables de Entorno
# ============================================

# --- Backend ---
# URL del frontend para CORS
FRONTEND_URL=http://localhost:3000

# Base de datos PostgreSQL (usa driver asyncpg)
DATABASE_URL=postgresql+asyncpg://urna_user:urna_pass@db:5432/urna_chihuahua

# Redis
REDIS_URL=redis://redis:6379

# Secretos de seguridad (generar valores largos y aleatorios, mínimo 32 chars)
JWT_SECRET=
HMAC_SECRET=
PROCESS_SALT=

# Modo desarrollo (1 para permitir localhost:5173)
DEV_MODE=0

# --- Frontend ---
# URL del backend
VITE_API_URL=http://localhost:8000

# --- Base de datos (docker-compose) ---
POSTGRES_USER=urna_user
POSTGRES_PASSWORD=
POSTGRES_DB=urna_chihuahua
