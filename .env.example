# ============================================
# Urna Digital Chihuahua - Variables de Entorno
# ============================================

# --- Backend ---
# URL del frontend (Vercel) para CORS
FRONTEND_URL=https://tu-proyecto.vercel.app

# Base de datos PostgreSQL (Render)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Redis (Render o Upstash)
REDIS_URL=redis://host:6379

# Secretos de seguridad (generar valores largos y aleatorios)
JWT_SECRET=super_secret_jwt_key_cambiar_en_produccion
HMAC_SECRET=super_secret_hmac_key_cambiar_en_produccion
PROCESS_SALT=salt_aleatorio_por_proceso_electoral

# Modo desarrollo (opcional, para permitir localhost:5173)
# DEV_MODE=1

# --- Frontend (Vercel) ---
# URL del backend en Render
VITE_API_URL=https://urna-digital-backend.onrender.com
